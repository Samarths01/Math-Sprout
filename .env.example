# SQLite file used by the Next.js server. Created on first run.
DATABASE_PATH=./data/math-sprout.sqlite

# Set to true when the site is served over HTTPS so the session cookie is Secure.
COOKIE_SECURE=false

# Port used by `npm start`. `npm run dev` listens on 43123.
PORT=43123

# Commit stamped on new attempts and practice sessions. When unset, the server uses git rev-parse HEAD, or the literal unknown.
# APP_BUILD_SHA=
