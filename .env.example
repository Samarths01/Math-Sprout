# SQLite file used by the Next.js server. Created on first run.
DATABASE_PATH=./data/math-sprout.sqlite

# Set to true when the site is served over HTTPS so the session cookie is Secure.
COOKIE_SECURE=false

# Port used by `npm start`. `npm run dev` listens on 43123.
PORT=43123

# Required for any deploy that is not a git checkout.
# When set, the server uses that value and does no git work. Without it, the server refreshes
# `git describe --always --dirty --abbrev=12` in the background. A save never waits on git.
# If neither resolves, the tag is `unknown` and before/after analysis excludes those rows.
# APP_BUILD_SHA=
